# Server-only secret — never NEXT_PUBLIC_-prefixed. Get a key at
# https://secure.fantasypros.com/api-keys/request/
FANTASYPROS_API_KEY=

# Sleeper needs no auth, so these are safe to expose to the client. Both have
# working defaults (the real "JHU Lads" league's completed 2025 season) —
# only set these to point at a different league.
NEXT_PUBLIC_SLEEPER_LEAGUE_ID=
NEXT_PUBLIC_DEMO_CURRENT_USER_ID=
